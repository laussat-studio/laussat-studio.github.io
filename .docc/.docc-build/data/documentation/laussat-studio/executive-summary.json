{"hierarchy":{"paths":[["doc:\/\/me.rismay.laussat\/documentation\/laussat-studio"]]},"identifier":{"url":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/executive-summary","interfaceLanguage":"swift"},"metadata":{"images":[{"type":"icon","identifier":"system-designs-google-maps-font-system-executive-summary-icon.svg"},{"type":"card","identifier":"system-designs-google-maps-font-system-executive-summary-card.svg"}],"roleHeading":"Behavioral Success Story","title":"Executive Summary","role":"article","color":{"standardColorIdentifier":"gray"}},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"doc-executive-summary-hero"}]},{"inlineContent":[{"type":"image","identifier":"system-designs-google-maps-font-system-executive-summary-hero"}],"type":"paragraph"},{"type":"heading","text":"Story","anchor":"Story","level":2},{"type":"paragraph","inlineContent":[{"text":"We moved from five competing typography APIs to a single canonical pipeline without breaking layout,","type":"text"},{"text":" ","type":"text"},{"text":"accessibility, or rollout velocity. The real win was behavioral: teams could change typography with","type":"text"},{"text":" ","type":"text"},{"text":"confidence, without fear of hidden import failures or regression storms.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The immediate design mandate was to stop looking like Apple Maps. We needed"},{"type":"text","text":" "},{"type":"text","text":"distinct Google fonts for action buttons and headline text while keeping Apple"},{"type":"text","text":" "},{"type":"text","text":"fonts for 16-point text and below."}],"type":"paragraph"},{"type":"heading","text":"Outcomes","anchor":"Outcomes","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Consolidated typography entry points into a single registry.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Reduced visual drift across UIKit and SwiftUI.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enabled staged rollouts with fast rollback controls.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Reduced the style catalog from roughly 15 styles to about 10.","type":"text"}]}]}]},{"text":"Why it worked","anchor":"Why-it-worked","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"We separated typography migration from import‑hygiene migration.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"We preserved legacy call sites with compatibility shims.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"We phased migration through shared components before feature surfaces.","type":"text"}]}]}]}]}],"references":{"laussat-studio-card.svg":{"type":"image","variants":[{"url":"\/images\/me.rismay.laussat\/laussat-studio-card.svg","svgID":"title","traits":["1x","light"]}],"identifier":"laussat-studio-card.svg","alt":"Studio Laussat Card"},"system-designs-google-maps-font-system-executive-summary-card.svg":{"type":"image","variants":[{"url":"\/images\/me.rismay.laussat\/system-designs-google-maps-font-system-executive-summary-card.svg","svgID":"title","traits":["1x","light"]}],"identifier":"system-designs-google-maps-font-system-executive-summary-card.svg","alt":null},"doc://me.rismay.laussat/documentation/laussat-studio":{"type":"topic","role":"article","identifier":"doc:\/\/me.rismay.laussat\/documentation\/laussat-studio","url":"\/documentation\/laussat-studio","images":[{"identifier":"laussat-studio-icon.svg","type":"icon"},{"type":"card","identifier":"laussat-studio-card.svg"}],"title":"Studio Laussat","abstract":[],"kind":"article"},"system-designs