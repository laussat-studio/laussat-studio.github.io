{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","metadata":{"title":"Strategy and Execution","color":{"standardColorIdentifier":"gray"},"roleHeading":"Migration Strategy","role":"article","images":[{"type":"icon","identifier":"system-designs-google-maps-font-system-strategy-and-execution-icon.svg"},{"type":"card","identifier":"system-designs-google-maps-font-system-strategy-and-execution-card.svg"}]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"doc-strategy-and-execution-hero"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"system-designs-google-maps-font-system-strategy-and-execution-hero"}]},{"anchor":"Approach","type":"heading","text":"Approach","level":2},{"inlineContent":[{"text":"We separated the typography migration from import‑hygiene cleanup. That let us ship a canonical","type":"text"},{"text":" ","type":"text"},{"text":"pipeline first, then remove transitive imports without breaking unrelated subsystems.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Phases","anchor":"Phases","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Define a shared token contract and registry.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add compatibility shims for legacy APIs."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Migrate shared components first."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Roll out to feature call sites with staged flags."}]}]}],"type":"orderedList"},{"level":2,"text":"Architecture Overview","anchor":"Architecture-Overview","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Token registry:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"design-system\/primatives\/fonts","type":"codeVoice"},{"text":" (sibling to colors) maps","type":"text"},{"text":" ","type":"text"},{"text":"semantic roles to font descriptors.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Provider layer:"}]},{"text":" resolves tokens to concrete fonts.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Adapters:"}],"type":"strong"},{"text":" UIKit and SwiftUI apply scaling and fallbacks.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shim layer:"}]},{"text":" legacy APIs route into tokens during transition.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Contract surface:"}],"type":"strong"},{"text":" a shared ","type":"text"},{"code":".h","type":"codeVoice"},{"text":" protocol that could link to either Apple","type":"text"},{"text":" ","type":"text"},{"text":"fonts or Google fonts.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Data Flows And Interfaces","anchor":"Data-Flows-And-Interfaces","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"text":"UI components request a semantic token rather than a raw font.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The provider resolves the token and applies Dynamic Type scaling.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":".h","type":"codeVoice"},{"text":" protocol routes to either Apple or Google font implementations.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Legacy entry points map to tokens before returning a UIFont or SwiftUI Font.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The runtime flow is detailed in the migration section to keep context with the diagram.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Reliability, Scalability, And Performance","anchor":"Reliability-Scalability-And-Performance","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"text":"Cached descriptors reduce repeated font construction.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Font mapping is deterministic to avoid layout jitter between releases.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Rollouts use flags to limit blast radius during regressions.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The libraries were guarded at compile time and runtime to keep linking safe."}]}]}],"type":"unorderedList"},{"text":"Security, Privacy, And Compliance","anchor":"Security-Privacy-And-Compliance","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No user data is processed by the font pipeline."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fonts are bundled and validated to avoid runtime fetches."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rollouts respect platform policies for Dynamic Type and accessibility."}]}]}]},{"text":"Behavioral shift","anchor":"Behavioral-shift","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Teams stopped hand‑tuning fonts per screen and instead aligned on semantic roles. The cost of a"},{"type":"text","text":" "},{"type":"text","text":"font change dropped from weeks of QA to a measured, staged rollout."}],"type":"paragraph"},{"text":"Diagram: Shared dependency map","anchor":"Diagram-Shared-dependency-map","type":"heading","level":2},{"inlineContent":[{"type":"image","identifier":"maps-font-dependency-map.mermaid"}],"type":"paragraph"},{"syntax":"mermaid","code":["%% file: maps-font-dependency-map.svg","%% title: Dependency map","flowchart TB","  subgraph DS[Design system layer]","    FP[FontProvider API]","    TK[Typography tokens]","    SH[Shim layer legacy to tokens]","  end","","  subgraph APPS[Apps]","    M[Maps iOS]","    X[Dependent iOS apps]","  end","","  TK --> FP","  SH --> TK","  M --> SH","  X --> SH"],"type":"codeListing"},{"text":"Diagram: Migration decision tree","anchor":"Diagram-Migration-decision-tree","type":"heading","level":2},{"inlineContent":[{"identifier":"maps-font-decision-tree.mermaid","type":"image"}],"type":"paragraph"},{"syntax":"mermaid","code":["%% file: maps-font-decision-tree.svg","%% title: Migration strategy decision tree","flowchart TB","  D0{Font migration approach}","  D0 --> D1[Big bang replacement]","  D0 --> D2[Incremental via shim and tokens]","","  D1 --> R1{Large surface area}","  R1 -->|Yes| O1[High risk and hard rollback]","  R1 -->|No| O2[Possible but rare at scale]","","  D2 --> R2{Multi app support}","  R2 -->|Yes| O3[Best path for shared API and safe rollout]","  R2 -->|No| O4[Still safer and more reviewable]","","  O3 --> P[Chosen: incremental via shim and tokens]"],"type":"codeListing"},{"text":"Diagram: Automation pipeline","anchor":"Diagram-Automation-pipeline","type":"heading","level":2},{"inlineContent":[{"identifier":"maps-font-automation-pipeline.mermaid","type":"image"}],"type":"paragraph"},{"syntax":"mermaid","code":["%% file: maps-font-automation-pipeline.svg","%% title: Automation pipeline","flowchart LR","  A[Codebase] --> B[Static scan for font call sites]","  B --> C[Cluster by module and owner]","  C --> D[Generate batch migrations]","  D --> E[Apply transform to token API]","  E --> F[Determine impacted tests]","  F --> G[Run targeted unit and UI tests]","  G --> H[Run snapshot suite]","  H --> I[Update baselines when expected]","  I --> J[Human review and triage]","  J --> K[Merge and track metrics]"],"type":"codeListing"}]}],"hierarchy":{"p