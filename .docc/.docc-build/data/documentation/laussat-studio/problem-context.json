{"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Problem and Context","roleHeading":"Why Typography Drifted","role":"article","images":[{"type":"icon","identifier":"system-designs-google-maps-font-system-problem-context-icon.svg"},{"type":"card","identifier":"system-designs-google-maps-font-system-problem-context-card.svg"}],"color":{"standardColorIdentifier":"gray"}},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"identifier":"doc-problem-context-hero","type":"image"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"system-designs-google-maps-font-system-problem-context-hero"}]},{"text":"Context","anchor":"Context","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Google Maps shipped across hundreds of screens with multiple font APIs, each owned by different","type":"text"},{"type":"text","text":" "},{"text":"teams over time. Typography changes triggered layout regressions, accessibility gaps, and","type":"text"},{"text":" ","type":"text"},{"text":"inconsistent rendering between UIKit and SwiftUI.","type":"text"}]},{"text":"Requirements And Constraints","type":"heading","level":2,"anchor":"Requirements-And-Constraints"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Support Dynamic Type and accessibility parity across every surface.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keep font rendering performance within existing layout budgets.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Avoid breaking import graphs during the migration."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Keep rollouts reversible with a fast kill switch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Limit churn so teams can keep shipping in parallel."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Root causes","anchor":"Root-causes","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Five parallel font API families."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Umbrella imports that coupled typography with unrelated design system modules."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Inconsistent scaling logic across screens and components."}]}]}]},{"level":2,"text":"Stakeholders And Ownership","anchor":"Stakeholders-And-Ownership","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Design systems:","type":"text"}]},{"type":"text","text":" defined typography tokens and semantic roles."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Maps iOS platform:","type":"text"}],"type":"strong"},{"text":" built the canonical pipeline and shims.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Feature teams:","type":"text"}]},{"text":" migrated call sites and validated layout behavior.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Quality and release:","type":"text"}]},{"text":" monitored rollouts and triaged regressions.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Diagram-Umbrella-coupling","type":"heading","text":"Diagram: Umbrella coupling"},{"type":"paragraph","inlineContent":[{"identifier":"maps-font-umbrella-before.mermaid","type":"image"}]},{"type":"codeListing","code":["%% file: maps-font-umbrella-before.svg","%% title: Before - Umbrella header coupling","flowchart LR","  subgraph FEATURES[Features hundreds of files]","    F1[Maps UI screens]","    F2[Search \/ Explore]","    F3[Navigation \/ ETA]","    F4[S