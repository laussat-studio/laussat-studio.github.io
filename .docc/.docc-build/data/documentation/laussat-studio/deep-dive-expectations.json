{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"doc-deep-dive-expectations-hero"}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"system-designs-google-maps-font-system-deep-dive-expectations-hero"}],"type":"paragraph"},{"text":"What they evaluate","anchor":"What-they-evaluate","level":2,"type":"heading"},{"inlineContent":[{"text":"They are evaluating senior impact: scope, ownership, complexity, execution,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"collaboration, and measurable outcomes. You win by being concrete, quantified,"},{"type":"text","text":" "},{"type":"text","text":"and decision-driven. This is not a code walkthrough."}],"type":"paragraph"},{"text":"Ten-minute narrative template","anchor":"Ten-minute-narrative-template","level":2,"type":"heading"},{"text":"0:00 To 0:45 - Context and Why It Mattered","anchor":"000-To-045-Context-and-Why-It-Mattered","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Problem, user impact, business risk, scale.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Mention that the work is within the last year.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"0:45 To 1:45 - What You Were Solving For and Scope","anchor":"045-To-145-What-You-Were-Solving-For-and-Scope","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Success definition and constraints.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Explicit non-goals and why they were excluded."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"1:45 To 3:00 - Ownership Boundaries","anchor":"145-To-300-Ownership-Boundaries","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"“I owned X end to end” from design to rollout and metrics.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"“I did not own Y, but I influenced it by Z.”"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"3:00 To 4:30 - One Visual","type":"heading","anchor":"300-To-430-One-Visual","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"One system diagram: client to services to storage and cache to observability."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Point out where the hard part lives and where failures are handled."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"4:30 To 6:30 - Technical Depth","anchor":"430-To-630-Technical-Depth","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Two to three decisions only."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"For each: decision, alternatives, tradeoff, why correct for constraints."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"6:30 To 7:30 - Execution and Rollout","anchor":"630-To-730-Execution-and-Rollout","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Milestones, feature flags, staged rollout, canary, regression handling."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Oncall follow-through."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"7:30 To 8:30 - Outcomes","anchor":"730-To-830-Outcomes","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Quantified before and after deltas."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Tie directly back to the original goal."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"8:30 To 9:30 - Collaboration and Mentoring","anchor":"830-To-930-Collaboration-and-Mentoring","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Partner teams, QA strategy, coordination mechanisms."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Mentoring and the resulting leverage."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"9:30 To 10:00 - Learnings and Next Step","anchor":"930-To-1000-Learnings-and-Next-Step","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"One technical learning, one process learning."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A credible next step.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Common-ways-candidates-lose","level":2,"type":"heading","text":"Common ways candidates lose"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Too much background and not enough “I did X; result was Y.”","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Listing technologies without explaining the choices.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"No rollout or validation story.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No metrics or only vague metrics."}]}]}]},{"anchor":"Transition-mindset","text":"Transition mindset","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Coding exercise mindset: ship correctness fast, prove with state and tests,"},{"type":"text","text":" "},{"type":"text","text":"polish last."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Deep dive mindset: tell a decision-and-results story, show ownership and"},{"type":"text","text":" "},{"type":"text","text":"impact with numbers."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Offer to draft the script","anchor":"Offer-to-draft-the-script","level":2,"type":"heading"},{"inlineContent":[{"text":"If you provide a one-paragraph description of your deep dive project","type":"text"},{"text":" ","type":"text"},{"text":"(problem, role, and one outcome metric), we will produce a tight 10-minute","type":"text"},{"text":" ","type":"text"},{"text":"script plus the diagram content you should draw from memory.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/me.rismay.laussat\/documentation\/laussat-studio"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","metadata":{"title":"Project Deep Dive Expectations","color":{"standardColorIdentifier":"gray"},"images":[{"identifier":"system-designs-google-maps-font-system-deep-dive-expectations-icon.svg","type":"icon"},{"identifier":"system-designs-google-maps-font-system-deep-dive-expectations-card.svg","type":"card"}],"role":"article","roleHeading":"Project Deep Dive Expectations"},"sections":[],"identifier":{"url":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/deep-dive-expectations","interfaceLanguage":"swift"},"references":{"doc-deep-dive-expectations-hero":{"alt":"Project Deep Dive Expectations hero","variants":[{"url":"\/images\/me.rismay.laussat\/doc-deep-dive-expectations-hero.svg","traits":["1x","light"]}],"type":"image","identifier":"doc-deep-dive-expectations-hero"},"system-designs-google-maps-font-system-deep-dive-expectations-card.svg":{"alt":null,"variants":[{"url":"\/images\/me.rismay.laussat\/system-designs-google-maps-font-system-deep-dive-expectations-card.svg","svgID":"title","traits":["1x","light"]}],"type":"image","identifier":"system-designs-google-maps-font-system-deep-dive-expectations-card.svg"},"doc://me.rismay.laussat/documentation/laussat-studio":{"type":"topic","role":"article","identifier":"doc:\/\/me.rismay.laussat\/documentation\/laussat-studio","url":"\/documentation\/laussat-studio","images":[{"identifier":"laussat-studio-icon.svg","type":"icon"},{"type":"card","identifier":"laussat-studio-card.svg"}],"title":"Studio Laussat","abstract":[],"kind":"article"},"laussat-studio-icon.svg":{"type":"image","identifier":"laussat-studio-icon.svg",