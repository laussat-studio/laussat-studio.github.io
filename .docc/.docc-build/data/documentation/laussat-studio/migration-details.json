{"hierarchy":{"paths":[["doc:\/\/me.rismay.laussat\/documentation\/laussat-studio"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/migration-details"},"metadata":{"title":"Font Migration Details","color":{"standardColorIdentifier":"gray"},"images":[{"type":"icon","identifier":"system-designs-google-maps-font-system-migration-details-icon.svg"},{"type":"card","identifier":"system-designs-google-maps-font-system-migration-details-card.svg"}],"role":"article","roleHeading":"Font Migration Details"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"doc-migration-details-hero"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"system-designs-google-maps-font-system-migration-details-hero"}]},{"level":2,"text":"Context","anchor":"Context","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The font migration replaced a fragmented typography surface with a canonical"},{"text":" ","type":"text"},{"text":"pipeline that was safe to roll out in a large iOS app ecosystem.","type":"text"}]},{"text":"Before state","level":2,"type":"heading","anchor":"Before-state"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Five parallel font API families were in use across hundreds of references."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Usage was direct and indirect, so many call sites depended on typography APIs"},{"type":"text","text":" "},{"type":"text","text":"through shared components and style builders."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One API family lived behind a design system umbrella header, which also"},{"type":"text","text":" "},{"type":"text","text":"re-exported non-typography subsystems."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing that umbrella to fix typography broke unrelated compile paths for"},{"type":"text","text":" "},{"type":"text","text":"colors, spacing, icons, metrics, macros, and utilities."}]}]}],"type":"unorderedList"},{"text":"Target state","level":2,"type":"heading","anchor":"Target-state"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"One canonical pipeline: tokens to provider to scaled font output.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Legacy entry points routed through shims that mapped into tokens.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Explicit imports replaced umbrella-based transitive dependencies.","type":"text"}]}]}]},{"type":"heading","text":"Diagram: Runtime font resolution","anchor":"Diagram-Runtime-font-resolution","level":2},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"maps-font-runtime-flow.mermaid"}]},{"code":["%% file: maps-font-runtime-flow.svg","%% title: Runtime font resolution flow","sequenceDiagram","  autonumber","  participant View as View or cell","  participant Token as TypographyToken","  participant Provider as FontProvider","  participant Scaler as DynamicTypeScaler","  participant Font as UIFont","","  View->>Token: request token titleMedium","  Token->>Provider: resolve token to descriptor","  Provider->>Scaler: apply content size category","  Scaler->>Font: return scaled font","  Font-->>View: set font"],"type":"codeListing","syntax":"mermaid"},{"type":"heading","text":"Diagram: Compat umbrella during transition","anchor":"Diagram-Compat-umbrella-during-transition","level":2},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"maps-font-umbrella-after.mermaid"}]},{"code":["%% file: maps-font-umbrella-after.svg","%% title: After - Canonical modules + compat facade","flowchart TB","  subgraph CANON[Canonical modules explicit layering]","    T[TypographyTokens + FontProvider]","    C[ColorTokens]","    I[IconCatalog]","    L[LayoutMetrics]","    A[Appearance\/Theming]","    X[Utilities]","  end","","  subgraph COMPAT[Compatibility facade temporary]","    U[DesignSystemCompat Umbrella]","  end","","  subgraph FEATURES[Features + components]","    F[Feature code]","    CMP[Reusable components]","  end","","  F -->|imports only what it uses| T","  F --> C","  F --> I","  CMP --> T","  CMP --> L","","  F -. legacy import .-> U","  CMP -. legacy import .-> U","","  U --> T","  U --> C","  U --> I","  U --> L","  U --> A","  U --> X","","  U --> R[Gradual elimination of transitive dependencies]"],"type":"codeListing","syntax":"mermaid"},{"type":"heading","text":"Migration strategy","anchor":"Migration-strategy","level":2},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Freeze the typography spec and build a token map.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Implement a new font API and a compatibility layer for legacy calls.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Scan the repo to inventory direct and indirect call sites.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Batch migrations by feature area to keep PRs reviewable.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Run targeted tests and snapshot updates per batch.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Roll out in canary stages with metrics gates.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Retire legacy APIs and enforce lint rules against old constructors.","type":"text"}],"type":"paragraph"}]}]},{"text":"Diagram: Migration plan","anchor":"Diagram-Migration-plan","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"maps-font-migration-plan.mermaid"}]},{"code":["%% file: maps-font-migration-plan.svg","%% title: Migration plan - Staged rollout","flowchart TB","  S0[0. Spec freeze + token map] --> S1[1. Build new font API]","  S1 --> S2[2. Create compatibility shims]","  S2 --> S3[3. Repo scan + call-site inventory]","  S3 --> S4[4. Batch migrations by feature area]","  S4 --> S5[5. Targeted tests + snapshot updates]","  S5 --> S6[6. Canary rollout + metrics]","  S6 --> S7[7. Full rollout + cleanup old APIs]","  S7 --> S8[8. Enforce: lint forbidden constructors]","","  S2 -. rollback .-> R1[Rollback: feature flag \/ kill switch]","  S6 -. rollback .-> R1"],"type":"codeListing","syntax":"mermaid"},{"type":"heading","text":"Automation pipeline","anchor":"Automation-pipeline","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Scan the codebase to locate font call sites.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cluster results by module and owner.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Generate PR-sized batches and apply transformations.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Run targeted tests and snapshot suites.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Triage diffs, update baselines when expected, and track metrics.","type":"text"}],"type":"paragraph"}]}]},{"text":"Snapshot triage loop","anchor":"Snapshot-triage-loop","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"If a diff is expected, update baselines and record the reason.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If a diff is a regression, fix the mapping or layout constraint.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"If a diff is noise, refine the test or filtering rule.","type":"text"}],"type":"paragraph"}]}]},{"text":"Rollout controls","anchor":"Rollout-controls","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Feature flags to enable quick rollback.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Canary cohorts by OS version and device class.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Monitoring for crash-free rate, layout regressions, and performance.","type":"text"}],"type":"paragraph"}]}]},{"text":"Testing And Validation","anchor":"Testing-And-Validation","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Snapshot suites for key screens at multiple Dynamic Type sizes.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Targeted UI tests for text-heavy flows and critical layouts."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Static analysis to block legacy API usage during the migration."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Runtime logging for fallback fonts and missing token mappings."}]}]}]},{"text":"Risks And Tradeoffs","anchor":"Risks-And-Tradeoffs","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Tradeoff:","type":"text"}],"type":"strong"},{"type":"text","text":" Temporary shim layer increases surface area."},{"type":"text","text":" "},{"inlineContent":[{"text":"Benefit:","type":"text"}],"type":"strong"},{"text":" Safe migration without breaking call sites.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Tradeoff:","type":"text"}]},{"type":"text","text":" Duplicate APIs during transition."},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Benefit:"}],"type":"strong"},{"type":"text","text":" Teams can migrate on their own schedule."}]}]}]},{"level":2,"text":"Decision rationale","anchor":"Decision-rationale","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A big-bang migration was rejected due to risk and review overhead."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"An incremental shim-based approach limited blast radius and enabled"},{"type":"text","text":" "},{"text":"multi-app adoption.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Shared components were migrated first to collapse indirect usage quickly.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"system-designs-google-maps-font-system-migration-details-icon.svg":{"type":"image","variants":[{"traits":["1x","light"],"svgID":"title","url":"\/images\/me.rismay.laussat\/system-designs-google-maps-font-system-migration-details-icon.svg"}],"identifier":"system-designs-google-maps-font-system-migration-details-icon.svg","alt":null},"doc://me.rismay.laussat/documentation/laussat-studio":{"type":"topic","role":"article","identifier":"doc:\/\/me.rismay.laussat\/documentation\/laussat-studio","url":"\/documentation\/laussat-studio","images":[{"identifier":"laussat-studio-icon.svg","type":"icon"},{"type":"card","identifier":"laussat-studio-card.svg"}],"title":"Studio Laussat","abstract":[],"kind":"article"},"system-designs-google-maps-font-system-migration-details-card.svg":{"type":"image","variants":[{"traits":["1x","light"],"svgID":"title","url":"\/images\/me.rismay.laussat\/system-designs-google-maps-font-system-migration-details-card.svg"}],"identifier":"system-designs-google-maps-font-system-migration-details-card.svg","alt":null},"doc-migration-details-hero":{"alt":"Font Migration Details hero","variants":[{"url":"\/images\/me.rismay.laussat\/doc-migration-details-hero.svg","traits":["1x","light"]}],"identifier":"doc-migration-details-hero","type":"image"},"maps-font-runtime-flow.merm