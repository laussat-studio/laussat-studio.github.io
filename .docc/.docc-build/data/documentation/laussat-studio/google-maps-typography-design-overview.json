{"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"Google Maps Typography Design Overview","role":"article","roleHeading":"Google Maps Typography Design Overview","images":[{"identifier":"system-designs-google-maps-font-system-google-maps-typography-design-overview-icon.svg","type":"icon"},{"identifier":"system-designs-google-maps-font-system-google-maps-typography-design-overview-card.svg","type":"card"}],"color":{"standardColorIdentifier":"gray"}},"sections":[],"primaryContentSections":[{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc-google-maps-typography-design-overview-hero","type":"image"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"system-designs-google-maps-font-system-google-maps-typography-design-overview-hero"}]},{"type":"paragraph","inlineContent":[{"text":"A case study on building a typography system for Google Maps iOS: how we moved","type":"text"},{"type":"text","text":" "},{"type":"text","text":"from fragmented font APIs to a canonical pipeline without breaking layout,"},{"text":" ","type":"text"},{"text":"accessibility, or performance at massive scale.","type":"text"}]},{"inlineContent":[{"text":"This case study follows the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/system-design-dimensions","type":"reference"},{"text":" template.","type":"text"}],"type":"paragraph"},{"anchor":"Related-pages","text":"Related pages","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/executive-summary","isActive":true}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/problem-context","type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/requirements-and-constraints"}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/stakeholders-and-ownership"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/strategy-and-execution","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/rollout-and-results","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/lessons","type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/migration-details"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/deep-dive-expectations"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/open-questions","type":"reference"}],"type":"paragraph"}]}]},{"text":"Template coverage","type":"heading","level":2,"anchor":"Template-coverage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This case study covers the following dimensions:"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Executive Summary, Problem Context, Goals and Non-goals, Requirements and"},{"type":"text","text":" "},{"type":"text","text":"Constraints, Stakeholders and Ownership, Architecture Overview, Data Flows and"},{"text":" ","type":"text"},{"type":"text","text":"Interfaces, Risks and Tradeoffs, Security, Privacy, Compliance, Reliability,"},{"type":"text","text":" "},{"type":"text","text":"Scalability, Performance, Observability and Operations, Testing and Validation,"},{"type":"text","text":" "},{"type":"text","text":"Migration and Rollout, Results and Metrics, and Lessons and Next Steps."}]},{"type":"paragraph","inlineContent":[{"text":"Optional dimensions if we expand later:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Appendix and References."}]},{"level":2,"anchor":"Problem-statement","type":"heading","text":"Problem statement"},{"type":"paragraph","inlineContent":[{"text":"Large iOS apps often hard-code fonts in dozens of UI layers. Changing a font","type":"text"},{"text":" ","type":"text"},{"text":"family can trigger layout regressions, accessibility issues, and inconsistent","type":"text"},{"text":" ","type":"text"},{"text":"visual output.","type":"text"}]},{"level":2,"anchor":"Context","type":"heading","text":"Context"},{"type":"paragraph","inlineContent":[{"text":"Google Maps shipped across hundreds of screens, each with its own local","type":"text"},{"text":" ","type":"text"},{"text":"typography practices. Multiple font APIs accumulated over years, and a shared","type":"text"},{"text":" ","type":"text"},{"text":"design system umbrella import pulled in typography along with unrelated","type":"text"},{"text":" ","type":"text"},{"text":"subsystems. Any change to typography risked breaking both UI layout and","type":"text"},{"text":" ","type":"text"},{"text":"import stability.","type":"text"}]},{"level":2,"anchor":"Role-and-scope","type":"heading","text":"Role and scope"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Scope:"}],"type":"strong"},{"type":"text","text":" iOS typography system and migration strategy."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Focus:","type":"text"}]},{"type":"text","text":" Build a canonical font pipeline and staged migration plan."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Constraints:","type":"text"}]},{"type":"text","text":" Avoid large-scale churn and keep rollouts reversible."}],"type":"paragraph"}]}]},{"level":2,"text":"Goals","anchor":"Goals","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Provide a single source of truth for typography across the app.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Support fast rollouts and safe rollbacks.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Preserve Dynamic Type and accessibility behavior.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keep rendering performance stable.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Non-goals","anchor":"Non-goals","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rewriting every UI to a new architecture."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing all legacy UIKit or SwiftUI typography usage."}]}]}],"type":"unorderedList"},{"level":2,"text":"Architecture overview","anchor":"Architecture-overview","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Font registry:","type":"text"}],"type":"strong"},{"type":"text","text":" A centralized registry that maps semantic roles to concrete"},{"type":"text","text":" "},{"type":"text","text":"font descriptors."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Theme adapters:","type":"text"}],"type":"strong"},{"type":"text","text":" UIKit and SwiftUI adapters that read from the registry and"},{"type":"text","text":" "},{"type":"text","text":"apply font scaling rules."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Migration layer:","type":"text"}],"type":"strong"},{"type":"text","text":" Compatibility helpers that bridge legacy font calls into"},{"type":"text","text":" "},{"type":"text","text":"the new system."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Release controls:","type":"text"}],"type":"strong"},{"type":"text","text":" A feature flag or configuration toggle to roll out fonts"},{"type":"text","text":" "},{"type":"text","text":"safely."}]}]}],"type":"unorderedList"},{"inlineContent":[{"identifier":"maps-font-level0.mermaid","type":"image"}],"type":"paragraph"},{"code":["%% file: maps-font-level0.svg","%% title: Google Maps Font Migration Level 0","flowchart LR","  A[Brand refresh \/ typography spec] --> B[New font API + tokens]","  B --> C[Shared UI kit \/ design system]","  C --> D[Google Maps iOS app]","  C --> E[Dependent iOS apps]","  D --> F[Dynamic Type + accessibility parity]","  E --> F","  B --> G[Reduce drift: single source of truth]"],"syntax":"mermaid","type":"codeListing"},{"text":"Execution strategy","type":"heading","anchor":"Execution-strategy","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Establish a canonical font registry and token contract.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add shims so legacy APIs flow through the new pipeline."}]}]},{"content":[{"inlineContent":[{"text":"Separate typography migration from import-hygiene migration to avoid","type":"text"},{"type":"text","text":" "},{"type":"text","text":"unbounded churn."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Roll out by shared components first, then feature call sites."}]}]}]},{"type":"heading","text":"Before state (what made this hard)","level":2,"anchor":"Before-state-what-made-this-hard"},{"inlineContent":[{"identifier":"maps-font-before-apis.mermaid","type":"image"}],"type":"paragraph"},{"type":"codeListing","syntax":"mermaid","code":["%% file: maps-font-before-apis.svg","%% title: Before - Five API families + direct\/indirect imports","flowchart TB","  subgraph CONSUMERS[Consumption sites - hundreds total]","    F[Feature screens \/ controllers \/ SwiftUI views]","    C[Reusable UI components - cells, buttons, headers]","    S[Style builders - NSAttributedString, text styles]","  end","","  subgraph APISETS[Five parallel typography API families]","    A[API A: Direct UIFont calls - systemFont \/ preferredFont]","    B[API B: Legacy helper - Font.style...]","    C1[API C: Design-system wrapper v1 - TerraTypography.*]","    D[API D: Feature-local extensions - UILabel+FeatureFonts]","    E[API E: Hard-coded fonts - font names\/sizes]","  end","","  F -. direct import .-> A","  F -. direct import .-> B","  F -. direct import .-> C1","  F -. direct import .-> D","  F -. direct import .-> E","","  F -->|indirect via dependency| C","  F -->|indirect via dependency| S","","  C --> A","  C --> B","  C --> C1","  C --> D","  C --> E","","  S --> A","  S --> B","  S --> C1","  S --> D","  S --> E","","  A --> P1[Scaling inconsistencies]","  B --> P2[Weight\/size drift]","  C1 --> P3[Token\/version skew]","  D --> P4[Local overrides]","  E --> P5[Hard-coded regressions]","","  P1 --> R[Snapshot noise + UI drift]","  P2 --> R","  P3 --> R","  P4 --> R","  P5 --> R"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Five parallel font API families"}]},{"type":"text","text":" spread across hundreds of references."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Import side effects:","type":"text"}]},{"text":" The typography API was also an import gateway. It","type":"text"},{"text":" ","type":"text"},{"text":"served as an umbrella header\/module for the entire design system.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Transitive import coupling:","type":"text"}],"type":"strong"},{"type":"text","text":" Removing the typography APIs to fix font"},{"text":" ","type":"text"},{"text":"drift was a structural change that severed transitive imports. Subsystems","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"like colors, spacing, icons, metrics, and macros would disappear from the"},{"text":" ","type":"text"},{"type":"text","text":"compile path."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Maps-scale churn:"}],"type":"strong"},{"text":" Deleting the umbrella immediately would trigger failures","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in unrelated code, exploding the churn and review risk."}]}]}]},{"text":"Canonical pipeline (after state)","level":2,"type":"heading","anchor":"Canonical-pipeline-after-state"},{"type":"paragraph","inlineContent":[{"identifier":"maps-font-after-canonical.mermaid","type":"image"}]},{"syntax":"mermaid","type":"codeListing","code":["%% file: maps-font-after-canonical.svg","%% title: After - Canonical typography pipeline + shims","flowchart TB","  subgraph CANON[Canonical typography pipeline]","    T[Typography Tokens - titleMedium, bodySmall]","    FP[FontProvider - token to font descriptor]","    DT[Dynamic Type Scaler - content size category]","    OUT[UIFont \/ attributed output]","    T --> FP --> DT --> OUT","  end","","  subgraph DIRECT[Direct usage - new code]","    F[Feature screens \/ controllers \/ views]","    F -->|direct use of tokens| T","  end","","  subgraph INDIRECT[Indirect usage - via dependencies]","    C[Reusable UI components]","    S[Style builders]","    C -->|component uses tokens| T","    S -->|builder uses tokens| T","    F -->|uses components\/builders| C","    F -->|uses components\/builders| S","  end","","  subgraph SHIMS[Temporary shims for legacy API families]","    SA[Shim A: direct UIFont calls to tokens]","    SB[Shim B: legacy helper to tokens]","    SC[Shim C: wrapper v1 to tokens]","    SD[Shim D: feature extensions to tokens]","    SE[Shim E: hard-coded detection to mapping]","  end","","  LEGACY[Legacy call sites + legacy deps] --> SA","  LEGACY --> SB","  LEGACY --> SC","  LEGACY --> SD","  LEGACY --> SE","","  SA --> T","  SB --> T","  SC --> T","  SD --> T","  SE --> T"]},{"level":2,"text":"Migration implications","anchor":"Migration-implications","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Decoupling concerns:"}]},{"type":"text","text":" The migration had to separate the canonical"},{"type":"text","text":" "},{"type":"text","text":"typography pipeline from the import-stability concern."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Compatibility facade:"}]},{"text":" An intentionally-managed compatibility facade was","type":"text"},{"text":" ","type":"text"},{"text":"required to preserve build stability. This allowed the umbrella to be retired","type":"text"},{"text":" ","type":"text"},{"text":"on a controlled schedule rather than the compiler’s schedule.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Parallel migrations:","type":"text"}],"type":"strong"},{"text":" This effectively created two parallel tracks:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Typography migration:"}],"type":"strong"},{"type":"text","text":" Five font entry points to tokens\/provider\/scaling."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Import hygiene migration:","type":"text"}]},{"type":"text","text":" Transitive umbrella imports to explicit imports."}]}]}],"type":"orderedList"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Operational strategy:","type":"text"}]},{"text":" The best order at scale was to migrate shared","type":"text"},{"text":" ","type":"text"},{"text":"components first (the largest source of indirect imports), then migrate","type":"text"},{"type":"text","text":" "},{"text":"feature call sites to collapse the transitive surface area fastest.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Data model","anchor":"Data-model"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Semantic roles:","type":"text"}]},{"text":" ","type":"text"},{"code":"display","type":"codeVoice"},{"text":", ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", ","type":"text"},{"code":"caption","type":"codeVoice"},{"text":", ","type":"text"},{"code":"code","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Variants:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"regular","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"medium"},{"type":"text","text":", "},{"type":"codeVoice","code":"semibold"},{"type":"text","text":", "},{"type":"codeVoice","code":"bold"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dynamic Type sizes:"}]},{"type":"text","text":" Mapped through "},{"code":"UIFontMetrics","type":"codeVoice"},{"type":"text","text":" or SwiftUI"},{"type":"text","text":" "},{"code":"Font","type":"codeVoice"},{"type":"text","text":" scaling."}]}]}]},{"level":2,"text":"Flow","anchor":"Flow","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product and design define semantic roles for screens and components."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Registry maps each role to a concrete font family + weight."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"UIKit\/SwiftUI adapters resolve fonts at render time."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Metrics instrumentation tracks layout and performance changes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rollout proceeds via staged flag and measurement gates."}]}]}],"type":"orderedList"},{"level":2,"text":"Observability","anchor":"Observability","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Crash-free sessions and layout regression reports."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dynamic Type visual diffs across supported sizes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Performance metrics for text rendering and layout passes."}]}]}],"type":"unorderedList"},{"level":2,"text":"Rollout strategy","anchor":"Rollout-strategy","type":"heading"},{"inlineContent":[{"text":"Begin with internal builds and TestFlight cohorts. Gate rollout by OS version","type":"text"},{"text":" ","type":"text"},{"text":"and device class. Maintain a rollback toggle to revert the font mapping quickly.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Risks and mitigations","anchor":"Risks-and-mitigations","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Risk:"}]},{"text":" Layout overflow in tight UI components. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Mitigation:"}]},{"text":" Targeted UI","type":"text"},{"text":" ","type":"text"},{"text":"snapshots with max Dynamic Type size.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Risk:"}]},{"text":" Custom font fallback if font file missing. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Mitigation:"}]},{"text":" Bundle","type":"text"},{"text":" ","type":"text"},{"text":"verification in CI and runtime fallback logging.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Risk:"}]},{"text":" Performance regression in text-heavy screens. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Mitigation:"}]},{"text":" Cache","type":"text"},{"text":" ","type":"text"},{"text":"font descriptors and profile layout passes.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Outcomes","anchor":"Outcomes","level":2},{"inlineContent":[{"text":"Centralized typography control with safer rollouts. Reduced visual drift across","type":"text"},{"text":" ","type":"text"},{"text":"UIKit and SwiftUI. A migration playbook that scaled across the product surface.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/me.rismay.laussat\/documentation\/laussat-studio","doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/system-designs"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/google-maps-typography-design-overview"},"references":{"doc://me.rismay.laussat/documentation/Laussat-Studio/stakeholders-and-ownership":{"kind":"article","role":"article","url":"\/documentation\/laussat-studio\/stakeholders-and-ownership","abstract":[],"title":"Stakeholders And Ownership","type":"topic","identifier":"doc:\/\/me.rismay.laussat\/documentation\/Laussat-Studio\/stakeholders-and-ownership"},"doc://me.rismay.laussat/documentation/Laussat-Studio/problem-context":{"kind":"article","role":"article","url":"\/documentation\/laussat-studio\/problem-context","abstract":[],"title":"Problem and Context","images":[{"identifier":"system-designs-google-maps-font-system-problem-context-icon.svg","type":"icon"},{"i