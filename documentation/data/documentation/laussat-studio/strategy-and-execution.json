{"kind":"article","metadata":{"images":[{"identifier":"system-designs-google-maps-font-system-strategy-and-execution-icon.codex.svg","type":"icon"},{"identifier":"system-designs-google-maps-font-system-strategy-and-execution-card.codex.svg","type":"card"}],"color":{"standardColorIdentifier":"gray"},"title":"Strategy and Execution","roleHeading":"Migration Strategy","role":"article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/laussat-studio\/documentation\/laussat-studio\/strategy-and-execution"},"sections":[],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"doc-strategy-and-execution-hero.codex"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"system-designs-google-maps-font-system-strategy-and-execution-hero.codex"}]},{"type":"heading","level":2,"anchor":"Approach","text":"Approach"},{"type":"paragraph","inlineContent":[{"text":"We separated the typography migration from import‑hygiene cleanup. That let us ship a canonical","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"pipeline first, then remove transitive imports without breaking unrelated subsystems."}]},{"inlineContent":[{"type":"text","text":"We also wrapped existing APIs first, keeping 15 legacy entry points while the new 10-style"},{"text":" ","type":"text"},{"text":"taxonomy proved itself. Five of the legacy styles were mapped to existing tokens rather than","type":"text"},{"text":" ","type":"text"},{"text":"creating new APIs.","type":"text"}],"type":"paragraph"},{"text":"Phases","type":"heading","level":2,"anchor":"Phases"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Define a shared token contract and registry.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add compatibility shims for legacy APIs."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Migrate shared components first.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Roll out to feature call sites with staged flags."}],"type":"paragraph"}]}]},{"type":"heading","text":"Architecture Overview","level":2,"anchor":"Architecture-Overview"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Token registry:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"design-system\/primatives\/fonts"},{"type":"text","text":" (sibling to colors) maps"},{"type":"text","text":" "},{"type":"text","text":"semantic roles to font descriptors."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Provider layer:"}]},{"type":"text","text":" resolves tokens to concrete fonts."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Adapters:"}]},{"type":"text","text":" UIKit and SwiftUI apply scaling and fallbacks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shim layer:"}]},{"type":"text","text":" legacy APIs route into tokens during transition."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Contract surface:"}]},{"type":"text","text":" a shared "},{"type":"codeVoice","code":".h"},{"type":"text","text":" protocol that could link to either Apple"},{"type":"text","text":" "},{"type":"text","text":"fonts or Google fonts."}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Data Flows And Interfaces","anchor":"Data-Flows-And-Interfaces"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"UI components request a semantic token rather than a raw font.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The provider resolves the token and applies Dynamic Type scaling."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":".h"},{"type":"text","text":" protocol routes to either Apple or Google font implementations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Legacy entry points map to tokens before returning a UIFont or SwiftUI Font.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The runtime flow is detailed in the migration section to keep context with the diagram."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"API surface was constrained to headline ("},{"code":"s","type":"codeVoice"},{"type":"text","text":", "},{"code":"m","type":"codeVoice"},{"type":"text","text":", "},{"code":"l","type":"codeVoice"},{"type":"text","text":"), body ("},{"code":"s","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"m"},{"type":"text","text":", "},{"type":"codeVoice","code":"l"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and text ("},{"type":"codeVoice","code":"s"},{"type":"text","text":", "},{"type":"codeVoice","code":"m"},{"type":"text","text":") to cap style explosion."}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"anchor":"Example-Search-Results-row","text":"Example: Search Results row"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Before:"}],"type":"strong"},{"text":" Title, subtitle, and distance badge each used separate helpers.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Token mapping:"}],"type":"strong"},{"type":"text","text":" "},{"code":"titleMedium.semibold","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"bodySmall.regular"},{"type":"text","text":", "},{"type":"codeVoice","code":"caption.regular"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Flagging:"}]},{"type":"text","text":" The new mapping was gated for the Search Results surface only."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Validation:"}],"type":"strong"},{"text":" Snapshot diffs at max Dynamic Type and scroll perf counters.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Reliability, Scalability, And Performance","type":"heading","anchor":"Reliability-Scalability-And-Performance"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Cached descriptors reduce repeated font construction.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Font mapping is deterministic to avoid layout jitter between releases.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Rollouts use flags to limit blast radius during regressions.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The libraries were guarded at compile time and runtime to keep linking safe.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The ten canonical styles were preloaded to reduce runtime churn."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Security, Privacy, And Compliance","type":"heading","anchor":"Security-Privacy-And-Compliance"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No user data is processed by the font pipeline."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fonts are bundled and validated to avoid runtime fetches."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rollouts respect platform policies for Dynamic Type and accessibility."}]}]}]},{"type":"heading","text":"Behavioral shift","anchor":"Behavioral-shift","level":2},{"type":"paragraph","inlineContent":[{"text":"Teams stopped hand‑tuning fonts per screen and instead aligned on semantic roles. The cost of a","type":"text"},{"text":" ","type":"text"},{"text":"font change dropped from weeks of QA to a measured, staged rollout.","type":"text"}]},{"type":"heading","text":"Diagram: Shared dependency map","anchor":"Diagram-Shared-dependency-map","level":2},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"maps-font-dependency-map.mermaid"}]},{"type":"codeListing","syntax":"mermaid","code":["%% file: maps-font-dependency-map.codex.svg","%% title: Dependency map","flowchart TB","  subgraph DS[Design system layer]","    FP[FontProvider API]","    TK[Typography tokens]","    SH[Shim layer legacy to tokens]","  end","","  subgraph APPS[Apps]","    M[Maps iOS]","    X[Dependent iOS apps]","  end","","  TK --> FP","  SH --> TK","  M --> SH","  X --> SH"]},{"type":"heading","text":"Diagram: Migration decision tree","anchor":"Diagram-Migration-decision-tree","level":2},{"inlineContent":[{"type":"image","identifier":"maps-font-decision-tree.mermaid"}],"type":"paragraph"},{"code":["%% file: maps-font-decision-tree.codex.svg","%% title: Migration strategy decision tree","flowchart TB","  D0{Font migration approach}","  D0 --> D1[Big bang replacement]","  D0 --> D2[Incremental via shim and tokens]","","  D1 --> R1{Large surface area}","  R1 -->|Yes| O1[High risk and hard rollback]","  R1 -->|No| O2[Possible but rare at scale]","","  D2 --> R2{Multi app support}","  R2 -->|Yes| O3[Best path for shared API and safe rollout]","  R2 -->|No| O4[Still safer and more reviewable]","","  O3 --> P[Chosen: incremental via shim and tokens]"],"syntax":"mermaid","type":"codeListing"},{"type":"heading","level":2,"anchor":"Diagram-Automation-pipeline","text":"Diagram: Automation pipeline"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"maps-font-automation-pipeline.mermaid"}]},{"code":["%% file: maps-font-automation-pipeline.codex