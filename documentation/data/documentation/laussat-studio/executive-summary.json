{"kind":"article","metadata":{"roleHeading":"Behavioral Success Story","role":"article","title":"Executive Summary","images":[{"type":"icon","identifier":"system-designs-google-maps-font-system-executive-summary-icon.codex.svg"},{"type":"card","identifier":"system-designs-google-maps-font-system-executive-summary-card.codex.svg"}],"color":{"standardColorIdentifier":"gray"}},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/laussat-studio\/documentation\/laussat-studio\/executive-summary"},"sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"image","identifier":"doc-executive-summary-hero.codex"}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"system-designs-google-maps-font-system-executive-summary-hero.codex"}],"type":"paragraph"},{"text":"Story","type":"heading","level":2,"anchor":"Story"},{"type":"paragraph","inlineContent":[{"text":"We moved from five competing typography APIs to a single canonical pipeline without breaking","type":"text"},{"type":"text","text":" "},{"type":"text","text":"layout, accessibility, or rollout velocity. The real win was behavioral: teams could change"},{"type":"text","text":" "},{"type":"text","text":"typography with confidence, without fear of hidden import failures or regression storms."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The immediate design mandate was to stop looking like Apple Maps. We needed distinct Google"},{"type":"text","text":" "},{"type":"text","text":"fonts for action buttons and headline text while keeping Apple fonts for 16-point text and below."}]},{"type":"paragraph","inlineContent":[{"text":"The example we used to validate the system design was the Search Results row: a title, subtitle,","type":"text"},{"text":" ","type":"text"},{"text":"and distance badge that previously drifted across teams and release trains.","type":"text"}]},{"text":"Outcomes","anchor":"Outcomes","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Consolidated typography entry points into a single registry."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Reduced visual drift across UIKit and SwiftUI.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Enabled staged rollouts with fast rollback controls."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Reduced the style catalog from roughly 15 styles to about 10."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Migrated a high-risk surface (Search Results) with no regressions at max Dynamic Type."}]}]}],"type":"unorderedList"},{"text":"Why it worked","anchor":"Why-it-worked","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"We separated typography migration from import‑hygiene migration.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"We preserved legacy call sites with compatibility shims.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"We phased migration through shared components before feature surfaces.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Diagram-Context-snapshot","type":"heading","level":2,"text":"Diagram: Context snapshot"},{"inlineContent":[{"identifier":"system-designs-google-maps-font-system-executive-summary-context.mermaid","type":"image"}],"type":"paragraph"},{"syntax":"mermaid","type":"codeListing","code":["%% file: system-designs-google-maps-font-system-executive-summary-context.svg","%% title: Executive Summary - Context snapshot","flowchart LR","  A[\"Executive Summary\"] --> B[\"Constraints and scope\"]","  B --> C[\"Complexity drivers\"]","  C --> D[\"Design tradeoffs\"]","  D --> E[\"Risk: regressions and drift\"]","  D --> F[\"Risk: migration cost\"]","  D --> G[\"Risk: stakeholder misalignment\"]"]},{"level":2,"text":"Start state","type":"heading","anchor":"Start-state"},{"inlineContent":[{"type":"image","identifier":"system-designs-google-maps-font-system-typography-stack-start"}],"type":"paragraph"},{"text":"Final state","type":"heading","level":2,"anchor":"Final-state"},{"inlineContent":[{"identifier":"system-designs-google-maps-font-system-typography-stack-hero","type":"image"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/laussat-studio\/documentation\/laussat-studio","doc:\/\/laussat-studio\/documentation\/laussat-studio\/system-designs","doc:\/\/laussat-studio\/documentation\/laussat-studio\/google-maps-typography-design-overview"]]},"references":{"system-designs-icon.codex.svg":{"alt":"System designs Icon","identifier":"system-designs-icon.codex.svg","type":"image","variants":[{"url":"\/images\/laussat-studio\/system-designs-icon.codex.svg","svgID":"title","traits":["1x","light"]}]},"system-designs-google-maps-font-system-executive-summary-icon.codex.svg":{"alt":null,"type":"image","variants":[{"url":"\/images\/laussat-studio\/system-designs-google-maps-font-system-executive-summary-icon.codex.svg","svgID":"title","traits":["1x","light"]}],"identifier":"system-designs-google-maps-font-system-executive-summary-icon.codex.svg"},"system-designs-google-maps-font-system-typography-stack-start":{"alt":"Typography stack before migration","type":"image","variants":[{"svgID":"tilt","traits":["1x","light"],"url":"\/images\/laussat-studio\/system-designs-google-maps-font-system-typography-stack-start.svg"}],"identifier":"system-designs-google-maps-font-system-typography-stack-start"},"doc://laussat-studio/documentation/laussat-studio/system-designs":{"kind":"article","title":"System designs","type":"topic","url":"\/documentation\/laussat-studio\/system-designs","identifier":"doc:\/\/laussat-studio\/documentation\/laussat-studio\/system-designs","role":"article","images":[{"type":"icon",