{"hierarchy":{"paths":[["doc:\/\/laussat-studio\/documentation\/laussat-studio"]]},"metadata":{"roleHeading":"Article","images":[{"identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.large-ios-teams.planning-and-decision-making-icon.codex.svg","type":"icon"},{"type":"card","identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.large-ios-teams.planning-and-decision-making-card.codex.svg"}],"role":"article","title":"Planning and decision making","color":{"standardColorIdentifier":"gray"}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/laussat-studio\/documentation\/laussat-studio\/challenge.large-ios-teams.planning-and-decision-making"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.large-ios-teams.planning-and-decision-making-hero.codex"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This page records how the Google Maps typography system addressed “Planning and decision making”."}]},{"type":"heading","anchor":"Challenge","level":2,"text":"Challenge"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Planning and decision-making were heavily impacted by the scale of change. For"},{"type":"text","text":" "},{"type":"text","text":"colors, teams previously assigned developers to update ~5k references, but we"},{"type":"text","text":" "},{"type":"text","text":"could not get buy-in to repeat that for typography."}]},{"text":"System design response","anchor":"System-design-response","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"We created a CLI refactor tool to perform migrations on a per-API basis. With"},{"type":"text","text":" "},{"type":"text","text":"40+ APIs, that meant writing 40+ scripts."}]},{"type":"heading","level":2,"anchor":"Evidence-and-remaining-risk","text":"Evidence and remaining risk"},{"type":"paragraph","inlineContent":[{"type":"text","text":"We negotiated extra time with management due to limited feature developers and"},{"type":"text","text":" "},{"text":"worked on tooling to simplify feature-dev input.","type":"text"}]},{"text":"Diagram: Context snapshot","anchor":"Diagram-Context-snapshot","level":2,"type":"heading"},{"inlineContent":[{"identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.large-ios-teams.planning-and-decision-making-context.mermaid","type":"image"}],"type":"paragraph"},{"syntax":"mermaid","type":"codeListing","code":["%% file: system-designs-google-maps-font-system-scaling-challenges-challenge.large-ios-teams.planning-and-decision-making-context.svg","%% title: Planning and decision making - Context snapshot","flowchart LR","  A[\"Challenge: Planning and decision making\"] --> B[\"Constraint or pressure\"]","  B --> C[\"System design response\"]","  C --> D[\"Evidence and remaining risk\"]"]}]}],"kind":"article","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://laussat-studio/documentation/laussat-studio":{"kind":"article","type":"topic","title":"Studio Laussat","url":"\/documentation\/laussat-studio","identifier":"doc:\/\/laussat-studio\/documentation\/laussat-studio","role":"article","images":[{"type":"icon","identifier":"laussat-studio-icon.codex.svg"},{"type":"card","identifier":"laussat-studio-card.codex.svg"}],"abstract":[]},"system-designs-google-maps-font-system-scaling-challenges-challenge.large-ios-teams.planning-and-decision-making-icon.codex.svg":{"variants":[{"url":"\/images\/laussat-studio\/system-designs-google-maps-font-system-scaling-challenges-challenge.large-ios-teams.planning-and-decision-making-icon.codex.svg","traits":["1x","light"],"svgID":"title"}],"type":"image","identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.large-ios-teams.planning-and-