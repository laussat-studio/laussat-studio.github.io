{"hierarchy":{"paths":[["doc:\/\/laussat-studio\/documentation\/laussat-studio","doc:\/\/laussat-studio\/documentation\/laussat-studio\/system-designs","doc:\/\/laussat-studio\/documentation\/laussat-studio\/google-maps-typography-design-overview"]]},"metadata":{"images":[{"identifier":"system-designs-google-maps-font-system-problem-context-icon.codex.svg","type":"icon"},{"identifier":"system-designs-google-maps-font-system-problem-context-card.codex.svg","type":"card"}],"title":"Problem and Context","roleHeading":"Why Typography Drifted","color":{"standardColorIdentifier":"gray"},"role":"article"},"identifier":{"url":"doc:\/\/laussat-studio\/documentation\/laussat-studio\/problem-context","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"identifier":"system-designs-google-maps-font-system-problem-context-hero.codex","type":"image"}],"type":"paragraph"},{"level":2,"text":"Context","anchor":"Context","type":"heading"},{"inlineContent":[{"text":"Google Maps shipped across hundreds of screens with multiple font APIs, each owned by different","type":"text"},{"text":" ","type":"text"},{"text":"teams over time. Typography changes triggered layout regressions, accessibility gaps, and","type":"text"},{"text":" ","type":"text"},{"text":"inconsistent rendering between UIKit and SwiftUI.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In the MD1 era, Roboto was deprecated and removed, while MD3 introduced Google Sans as the","type":"text"},{"text":" ","type":"text"},{"text":"replacement type system.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Headlines shifted to Medium weight instead of larger sizes, with Bold reserved as an Ads-only","type":"text"},{"text":" ","type":"text"},{"text":"exception.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Search Results was the canary: titles, subtitles, and distance badges were defined in three","type":"text"},{"text":" ","type":"text"},{"text":"different font helpers, creating visible drift and unpredictable truncation.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Requirements and constraints","anchor":"Requirements-and-constraints","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Support Dynamic Type and accessibility parity across every surface."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Keep font rendering performance within existing layout budgets."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Avoid breaking import graphs during the migration."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Keep rollouts reversible with a fast kill switch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Limit churn so teams can keep shipping in parallel."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Root causes","anchor":"Root-causes","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Five parallel font API families."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Umbrella imports that coupled typography with unrelated design system modules."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Inconsistent scaling logic across screens and components.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No shared cache for font descriptors, causing repeated work in scroll-heavy views.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Diagram: API sprawl (before state)","anchor":"Diagram-API-sprawl-before-state","type":"heading"},{"inlineContent":[{"identifier":"maps-font-before-apis-40plus.mermaid","type":"image"}],"type":"paragraph"},{"code":["%% file: maps-font-before-apis-40plus.svg","%% title: Before - 40 plus font APIs across the codebase","flowchart LR","  A[\"Codebase: 40 plus font APIs\"] --> B[\"Enum-based API (Swift)\"]","  A --> C[\"Objective-C class API\"]","  A --> D[\"Direct UIFont usage\"]","  A --> E[\"Legacy helpers and wrappers\"]","  A --> N[\"No single answer for developers\"]","","  B --> B1[\"FontStyle enum<br>case body<br>case display\"]","  C --> C1[\"LSFontCatalog<br>+fontForRole:\"]","  D --> D1[\"UIFont.systemFont\"]","  D --> D2[\"UIFont(name:, size:)\"]","  E --> E1[\"feature-specific helpers\"]","  E --> E2[\"one-off overrides\"]","  N --> N1[\"Teams chose different APIs\"]","  N --> N2[\"Inconsistent UI outcomes\"]","","  A --> F[\"Scaling logic diverges\"]","  F --> G[\"Layout regressions\"]","  F --> H[\"Accessibility gaps\"]","  F --> I[\"UIKit vs SwiftUI mismatch\"]"],"syntax":"mermaid","type":"codeListing"},{"level":2,"text":"Stakeholders and ownership","anchor":"Stakeholders-and-ownership","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Design systems:"}],"type":"strong"},{"text":" defined typography tokens and semantic roles.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Maps iOS platform:"}],"type":"strong"},{"text":" built the canonical pipeline and shims.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Feature teams:"}],"type":"strong"},{"text":" migrated call sites and validated layout behavior.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Quality and release:"}],"type":"strong"},{"text":" monitored rollouts and triaged regressions.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Diagram: Umbrella coupling","anchor":"Diagram-Umbrella-coupling","type":"heading"},{"inlineContent":[{"identifier":"maps-font-umbrella-before.mermaid","type":"image"}],"type":"paragraph"},{"code":[