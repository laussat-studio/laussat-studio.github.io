{"kind":"article","metadata":{"role":"article","images":[{"identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.localization-icon.codex.svg","type":"icon"},{"identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.localization-card.codex.svg","type":"card"}],"color":{"standardColorIdentifier":"gray"},"roleHeading":"Article","title":"Localization"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/laussat-studio\/documentation\/laussat-studio\/challenge.app-complexity.localization","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.localization-hero.codex","type":"image"}]},{"type":"paragraph","inlineContent":[{"text":"This page records how the Google Maps typography system addressed “Localization”.","type":"text"}]},{"text":"Challenge","anchor":"Challenge","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Google Fonts introduced taller ascenders and descenders than the default Apple","type":"text"},{"text":" ","type":"text"},{"text":"typefaces. That created localization risk: glyph height varies across scripts,","type":"text"},{"text":" ","type":"text"},{"text":"and layouts tuned for SF could clip or regress once the new fonts landed.","type":"text"}]},{"inlineContent":[{"text":"Han unification was a concern, but the rollout scope was limited to Hong Kong.","type":"text"}],"type":"paragraph"},{"level":2,"text":"System design response","anchor":"System-design-response","type":"heading"},{"inlineContent":[{"text":"Key labels disabled ","type":"text"},{"code":"clipToBounds","type":"codeVoice"},{"text":" to accommodate Google Sans ascenders on iOS.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"That avoided truncation without reworking every baseline or line-height rule."}],"type":"paragraph"},{"level":2,"text":"Evidence and remaining risk","anchor":"Evidence-and-remaining-risk","type":"heading"},{"inlineContent":[{"text":"Remaining risk: even if the rollout focused on Hong Kong, Chinese users can","type":"text"},{"type":"text","text":" "},{"text":"travel abroad, so localization exposure extends beyond a single region.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vietnamese localization remains especially difficult. Future work: use new"},{"text":" ","type":"text"},{"type":"text","text":"locale-aware labels."}]},{"text":"Diagram: Context snapshot","type":"heading","level":2,"anchor":"Diagram-Context-snapshot"},{"type":"paragraph","inlineContent":[{"identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.localization-context.mermaid","type":"image"}]},{"code":["%% file: system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.localization-context.svg","%% title: Localization - Context snapshot","flowchart LR","  A[\"Challenge: Localization\"] --> B[\"Constraint or pressure\"]","  B --> C[\"System design response\"]","  C --> D[\"Evidence and remaining risk\"]"],"syntax":"mermaid","type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/laussat-studio\/documentation\/laussat-studio"]]},"references":{"system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.localization-icon.codex.svg":{"alt":null,"type":"image","variants":[{"url":"\/images\/laussat-studio\/system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.localization-icon.codex.svg","svgID":"title","traits":["1x","light"]}],"identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.localization-icon.codex.svg"},"doc://laussat-studio/documentation/laussat-studio":{"kind":"artic