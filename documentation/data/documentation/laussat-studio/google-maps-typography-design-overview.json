{"hierarchy":{"paths":[["doc:\/\/laussat-studio\/documentation\/laussat-studio","doc:\/\/laussat-studio\/documentation\/laussat-studio\/system-designs"]]},"metadata":{"images":[{"identifier":"system-designs-google-maps-font-system-google-maps-typography-design-overview-icon.codex.svg","type":"icon"},{"identifier":"system-designs-google-maps-font-system-google-maps-typography-design-overview-card.codex.svg","type":"card"}],"roleHeading":"Google Maps Typography Design Overview","role":"article","title":"Google Maps Typography Design Overview","color":{"standardColorIdentifier":"gray"}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/laussat-studio\/documentation\/laussat-studio\/google-maps-typography-design-overview"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"identifier":"system-designs-google-maps-font-system-google-maps-typography-design-overview-hero.codex","type":"image"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A case study on building a typography system for Google Maps iOS: how we moved","type":"text"},{"type":"text","text":" "},{"text":"from fragmented font APIs to a canonical pipeline without breaking layout,","type":"text"},{"type":"text","text":" "},{"text":"accessibility, or performance at massive scale.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This case study follows the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/laussat-studio\/documentation\/laussat-studio\/system-design-dimensions","type":"reference"},{"text":" template.","type":"text"}]},{"level":2,"text":"Reference example","anchor":"Reference-example","type":"heading"},{"inlineContent":[{"type":"text","text":"This case study uses the Search Results row as the reference surface for the"},{"text":" ","type":"text"},{"type":"text","text":"system design: title, subtitle, and distance badge mapped to canonical tokens,"},{"type":"text","text":" "},{"type":"text","text":"validated at max Dynamic Type, and gated behind a surface-level rollout flag."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Template coverage","anchor":"Template-coverage"},{"type":"paragraph","inlineContent":[{"text":"This case study covers the following dimensions:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Executive Summary, Problem Context, Goals and Non-goals, Requirements and"},{"text":" ","type":"text"},{"text":"Constraints, Stakeholders and Ownership, Architecture Overview, Data Flows and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Interfaces, Risks and Tradeoffs, Security, Privacy, Compliance, Reliability,"},{"type":"text","text":" "},{"type":"text","text":"Scalability, Performance, Observability and Operations, Testing and Validation,"},{"text":" ","type":"text"},{"type":"text","text":"Migration and Rollout, Results and Metrics, and Lessons and Next Steps."}]},{"inlineContent":[{"text":"Optional dimensions if we expand later:","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Appendix and References."}]},{"text":"Problem statement","anchor":"Problem-statement","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Large iOS apps often hard-code fonts in dozens of UI layers. Changing a font","type":"text"},{"type":"text","text":" "},{"text":"family can trigger layout regressions, accessibility issues, and inconsistent","type":"text"},{"text":" ","type":"text"},{"text":"visual output.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The change was also a brand clarity issue: users struggled to distinguish"},{"type":"text","text":" "},{"type":"text","text":"Google Maps from Apple Maps without a distinct typography signature."}],"type":"paragraph"},{"level":2,"text":"Context","type":"heading","anchor":"Context"},{"type":"paragraph","inlineContent":[{"text":"Google Maps shipped across hundreds of screens, each with its own local","type":"text"},{"type":"text","text":" "},{"type":"text","text":"typography practices. Multiple font APIs accumulated over years, and a shared"},{"text":" ","type":"text"},{"type":"text","text":"design system umbrella import pulled in typography along with unrelated"},{"type":"text","text":" "},{"text":"subsystems. Any change to typography risked breaking both UI layout and","type":"text"},{"type":"text","text":" "},{"text":"import stability.","type":"text"}]},{"type":"heading","level":2,"anchor":"Role-and-scope","text":"Role and scope"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Scope:"}]},{"type":"text","text":" iOS typography system and migration strategy."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Focus:","type":"text"}]},{"type":"text","text":" Build a canonical font pipeline and staged migration plan."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Constraints:","type":"text"}]},{"type":"text","text":" Avoid large-scale churn and keep rollouts reversible."}]}]}]},{"anchor":"Goals","type":"heading","level":2,"text":"Goals"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Provide a single source of truth for typography across the app."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Support fast rollouts and safe rollbacks."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Preserve Dynamic Type and accessibility behavior."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Keep rendering performance stable."}],"type":"paragraph"}]}]},{"anchor":"Non-goals","type":"heading","level":2,"text":"Non-goals"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rewriting every UI to a new architecture."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing all legacy UIKit or SwiftUI typography usage."}]}]}],"type":"unorderedList"},{"level":2,"text":"Architecture overview","type":"heading","anchor":"Architecture-overview"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Font registry:"}]},{"type":"text","text":" A centralized registry that maps semantic roles to concrete"},{"type":"text","text":" "},{"type":"text","text":"font descriptors."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Theme adapters:"}],"type":"strong"},{"type":"text","text":" UIKit and SwiftUI adapters that read from the registry and"},{"type":"text","text":" "},{"type":"text","text":"apply font scaling rules."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Migration layer:","type":"text"}]},{"type":"text","text":" Compatibility helpers that bridge legacy font calls into"},{"type":"text","text":" "},{"type":"text","text":"the new system."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Release controls:"}],"type":"strong"},{"text":" A feature flag or configuration toggle to roll out fonts","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"safely."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Telemetry hooks:"}]},{"type":"text","text":" Snapshot diff signals, runtime warnings, and performance"},{"text":" ","type":"text"},{"type":"text","text":"counters for layout and text rendering."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"image","identifier":"maps-font-level0.mermaid"}],"type":"paragraph"},{"code":["%% file: maps-font-level0.codex.svg","%% title: Google Maps Font Migration Level 0","flowchart LR","  A[Brand refresh \/ typography spec] --> B[New font API + tokens]","  B --> C[Shared UI kit \/ design system]","  C --> D[Google Maps iOS app]","  C --> E[Dependent iOS apps]","  D --> F[Dynamic Type + accessibility parity]","  E --> F","  B --> G[Reduce drift: single source of truth]"],"type":"codeListing","syntax":"mermaid"},{"text":"Execution strategy","anchor":"Execution-strategy","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Establish a canonical font registry and token contract.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add shims so legacy APIs flow through the new pipeline."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Separate typography migration from import-hygiene migration to avoid"},{"type":"text","text":" "},{"text":"unbounded churn.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Roll out by shared components first, then feature call sites."}],"type":"paragraph"}]}]},{"text":"Before state (what made this hard)","anchor":"Before-state-what-made-this-hard","level":2,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"maps-font-before-apis.mermaid"}],"type":"paragraph"},{"code":["%% file: maps-font-before-apis.codex.svg","%% title: Before - Five API families + direct\/indirect imports","flowchart TB","  subgraph CONSUMERS[Consumption sites - hundreds total]","    F[Feature screens \/ controllers \/ SwiftUI views]","    C[Reusable UI components - cells, buttons, headers]","    S[Style builders - NSAttributedString, text styles]","  end","","  subgraph APISETS[Five parallel typography API families]","    A[API A: Direct UIFont calls - systemFont \/ preferredFont]","    B[API B: Legacy helper - Font.style...]","    C1[API C: Design-system wrapper v1 - TerraTypography.*]","    D[API D: Feature-local extensions - UILabel+FeatureFonts]","    E[API E: Hard-coded fonts - font names\/sizes]","  end","","  F -. direct import .-> A","  F -. direct import .-> B","  F -. direct import .-> C1","  F -. direct import .-> D","  F -. direct import .-> E","","  F -->|indirect via dependency| C","  F -->|indirect via dependency| S","","  C --> A","  C --> B","  C --> C1","  C --> D","  C --> E","","  S --> A","  S --> B","  S --> C1","  S --> D","  S --> E","","  A --> P1[Scaling inconsistencies]","  B --> P2[Weight\/size drift]","  C1 --> P3[Token\/version skew]","  D --> P4[Local overrides]","  E --> P5[Hard-coded regressions]","","  P1 --> R[Snapshot noise + UI drift]","  P2 --> R","  P3 --> R","  P4 --> R","  P5 --> R"],"type":"codeListing","syntax":"mermaid"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Five parallel font API families"}]},{"type":"text","text":" spread across hundreds of references."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Import side effects:"}]},{"type":"text","text":" The typography API was also an import gateway. It"},{"type":"text","text":" "},{"type":"text","text":"served as an umbrella header\/module for the entire design system."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Transitive import coupling:"}],"type":"strong"},{"type":"text","text":" Removing the typography APIs to fix font"},{"type":"text","text":" "},{"type":"text","text":"drift was a structural change that severed transitive imports. Subsystems"},{"type":"text","text":" "},{"type":"text","text":"like colors, spacing, icons, metrics, and macros would disappear from the"},{"type":"text","text":" "},{"type":"text","text":"compile path."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Maps-scale churn:","type":"text"}]},{"type":"text","text":" Deleting the umbrella immediately would trigger failures"},{"type":"text","text":" "},{"type":"text","text":"in unrelated code, exploding the churn and review risk."}],"type":"paragraph"}]}]},{"level":2,"text":"Canonical pipeline (after state)","anchor":"Canonical-pipeline-after-state","type":"heading"},{"inlineContent":[{"type":"image","identifier":"maps-font-after-canonical.mermaid"}],"type":"paragraph"},{"syntax":"mermaid","type":"codeListing","code":["%% file: maps-font-after-canonical.codex.svg","%% title: After - Canonical typography pipeline + shims","flowchart TB","  subgraph CANON[Canonical typography pipeline]","    T[Typography Tokens - titleMedium, bodySmall]","    FP[FontProvider - token to font descriptor]","    DT[Dynamic Type Scaler - content size category]","    OUT[UIFont \/ attributed output]","    T --> FP --> DT --> OUT","  end","","  subgraph DIRECT[Direct usage - new code]","    F[Feature screens \/ controllers \/ views]","    F -->|direct use of tokens| T","  end","","  subgraph INDIRECT[Indirect usage - via dependencies]","    C[Reusable UI components]","    S[Style builders]","    C -->|component uses tokens| T","    S -->|builder uses tokens| T","    F -->|uses components\/builders| C","    F -->|uses components\/builders| S","  end","","  subgraph SHIMS[Temporary shims for legacy API families]","    SA[Shim A: direct UIFont calls to tokens]","    SB[Shim B: legacy helper to tokens]","    SC[Shim C: wrapper v1 to tokens]","    SD[Shim D: feature extensions to tokens]","    SE[Shim E: hard-coded detection to mapping]","  end","","  LEGACY[Legacy call sites + legacy deps] --> SA","  LEGACY --> SB","  LEGACY --> SC","  LEGACY --> SD","  LEGACY --> SE","","  SA --> T","  SB --> T","  SC --> T","  SD --> T","  SE --> T"]},{"text":"Migration implications","type":"heading","level":2,"anchor":"Migration-implications"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Decoupling concerns:"}]},{"type":"text","text":" The migration had to separate the canonical"},{"type":"text","text":" "},{"type":"text","text":"typography pipeline from the import-stability concern."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Compatibility facade:"}]},{"type":"text","text":" An intentionally-managed compatibility facade was"},{"type":"text","text":" "},{"type":"text","text":"required to preserve build stability. This allowed the umbrella to be retired"},{"text":" ","type":"text"},{"text":"on a controlled schedule rather than the compiler’s schedule.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Parallel migrations:"}],"type":"strong"},{"text":" This effectively created two parallel tracks:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Typography migration:"}],"type":"strong"},{"text":" Five font entry points to tokens\/provider\/scaling.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Import hygiene migration:"}],"type":"strong"},{"text":" Transitive umbrella imports to explicit imports.","type":"text"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Operational strategy:"}]},{"type":"text","text":" The best order at scale was to migrate shared"},{"type":"text","text":" "},{"type":"text","text":"components first (the largest source of indirect imports), then migrate"},{"type":"text","text":" "},{"type":"text","text":"feature call sites to collapse the transitive surface area fastest."}]}]}],"type":"unorderedList"},{"text":"Data model","type":"heading","level":2,"anchor":"Data-model"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Semantic roles:"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"display"},{"type":"text","text":", "},{"type":"codeVoice","code":"title"},{"type":"text","text":", "},{"type":"codeVoice","code":"body"},{"type":"text","text":", "},{"type":"codeVoice","code":"caption"},{"type":"text","text":", "},{"type":"codeVoice","code":"code"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Variants:"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"regular"},{"type":"text","text":", "},{"type":"codeVoice","code":"medium"},{"type":"text","text":", "},{"type":"codeVoice","code":"semibold"},{"type":"text","text":", "},{"type":"codeVoice","code":"bold"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dynamic Type sizes:"}]},{"type":"text","text":" Mapped through "},{"type":"codeVoice","code":"UIFontMetrics"},{"type":"text","text":" or SwiftUI"},{"type":"text","text":" "},{"type":"codeVoice","code":"Font"},{"type":"text","text":" scaling."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Locale rules:"}]},{"type":"text","text":" Per-locale font fallback chain for missing glyphs."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Brand channel:"}]},{"type":"text","text":" Stable keys for A\/B fonts without forcing API changes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"API surface:"}]},{"type":"text","text":" Headline ("},{"type":"codeVoice","code":"s"},{"type":"text","text":", "},{"type":"codeVoice","code":"m"},{"type":"text","text":", "},{"type":"codeVoice","code":"l"},{"type":"text","text":"), body ("},{"type":"codeVoice","code":"s"},{"type":"text","text":", "},{"type":"codeVoice","code":"m"},{"type":"text","text":", "},{"type":"codeVoice","code":"l"},{"type":"text","text":"), text ("},{"type":"codeVoice","code":"s"},{"type":"text","text":", "},{"type":"codeVoice","code":"m"},{"type":"text","text":")."}]}]}],"type":"unorderedList"},{"text":"Flow","type":"heading","level":2,"anchor":"Flow"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product and design define semantic roles for screens and components."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Registry maps each role to a concrete font family + weight."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"UIKit\/SwiftUI adapters resolve fonts at render time."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Metrics instrumentation tracks layout and performance changes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rollout proceeds via staged flag and measurement gates."}]}]}],"type":"orderedList"},{"text":"System design aspects","type":"heading","level":2,"anchor":"System-design-aspects"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Single source of truth:"}]},{"type":"text","text":" Tokens live in a shared module consumed by app and"},{"type":"text","text":" "},{"type":"text","text":"UI kit. Changes are versioned and reviewed like API changes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Caching policy:"}]},{"type":"text","text":" Fonts are cached at the descriptor level to avoid repeated"},{"type":"text","text":" "},{"type":"text","text":"weight\/size work on scroll-heavy views."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Feature flags:"}]},{"type":"text","text":" One global flag gates the new mapping plus a per-surface"},{"type":"text","text":" "},{"type":"text","text":"override for high-risk screens."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Failure modes:"}]},{"type":"text","text":" Missing font file falls back to system font and emits a"},{"type":"text","text":" "},{"type":"text","text":"runtime diagnostic event."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Operational guardrails:"}]},{"type":"text","text":" Snapshot diffs at all Dynamic Type sizes gate"},{"type":"text","text":" "},{"type":"text","text":"promotion to the next rollout tier."}]}]}],"type":"unorderedList"},{"text":"Observability","type":"heading","level":2,"anchor":"Observability"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Crash-free sessions and layout regression reports."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dynamic Type visual diffs across supported sizes."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Performance metrics for text rendering and layout passes."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Token adoption coverage by module and surface."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Rollback rate and error spikes tied to font load failures."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Rollout strategy","type":"heading","anchor":"Rollout-strategy"},{"inlineContent":[{"type":"text","text":"Begin with internal builds and TestFlight cohorts. Gate rollout by OS version"},{"type":"text","text":" "},{"type":"text","text":"and device class. Maintain a rollback toggle to revert the font mapping quickly."}],"type":"paragraph"},{"level":2,"text":"Example: Search results row","type":"heading","anchor":"Example-Search-results-row"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Context:"}]},{"text":" A search results list cell renders a title, subtitle, and distance","type":"text"},{"text":" ","type":"text"},{"text":"badge. Before the migration, each element picked a font locally and drifted","type":"text"},{"text":" ","type":"text"},{"text":"across releases.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Token mapping:"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Title: "},{"type":"codeVoice","code":"titleMedium.semibold"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Subtitle: ","type":"text"},{"type":"codeVoice","code":"bodySmall.regular"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Distance badge: "},{"type":"codeVoice","code":"caption.regular"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Render path:","type":"text"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cell requests tokens from the registry."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Registry resolves to the brand family and weight."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Adapter applies Dynamic Type scaling."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cached descriptor returns on subsequent rows."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Migration path:","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Legacy calls routed through shim D (feature extensions) to tokens."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Feature flag enables the new mapping for the search surface only.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Snapshot tests compare small\/large Dynamic Type sizes before rollout."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":