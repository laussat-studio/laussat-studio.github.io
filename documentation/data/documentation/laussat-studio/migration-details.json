{"kind":"article","metadata":{"color":{"standardColorIdentifier":"gray"},"title":"Font Migration Details","images":[{"identifier":"system-designs-google-maps-font-system-migration-details-icon.codex.svg","type":"icon"},{"identifier":"system-designs-google-maps-font-system-migration-details-card.codex.svg","type":"card"}],"roleHeading":"Font Migration Details","role":"article"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/laussat-studio\/documentation\/laussat-studio\/migration-details","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"image","identifier":"doc-migration-details-hero.codex"}],"type":"paragraph"},{"inlineContent":[{"identifier":"system-designs-google-maps-font-system-migration-details-hero.codex","type":"image"}],"type":"paragraph"},{"text":"Context","type":"heading","anchor":"Context","level":2},{"inlineContent":[{"text":"The font migration replaced a fragmented typography surface with a canonical","type":"text"},{"type":"text","text":" "},{"text":"pipeline that was safe to roll out in a large iOS app ecosystem.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Before-state","text":"Before state"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Five parallel font API families were in use across hundreds of references.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Usage was direct and indirect, so many call sites depended on typography APIs","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"through shared components and style builders."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One API family lived behind a design system umbrella header, which also"},{"type":"text","text":" "},{"type":"text","text":"re-exported non-typography subsystems."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing that umbrella to fix typography broke unrelated compile paths for"},{"text":" ","type":"text"},{"text":"colors, spacing, icons, metrics, macros, and utilities.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Example calls included:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"UIFont fontWith","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"AZFontWithStyle(enum1)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MDCFont.font1"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MDC2Font.font4"},{"type":"text","text":" (reversed to match "},{"code":"font1","type":"codeVoice"},{"type":"text","text":" over time)"}],"type":"paragraph"}]}],"type":"unorderedList"}]}]},{"type":"heading","level":2,"anchor":"Target-state","text":"Target state"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One canonical pipeline: tokens to provider to scaled font output."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Legacy entry points routed through shims that mapped into tokens."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Explicit imports replaced umbrella-based transitive dependencies."}]}]},{"content":[{"inlineContent":[{"text":"An intermediate cache sat between token resolution and UIFont creation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Cache keys used font family + size; eviction triggered on memory warnings."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"New API entry points exposed:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"fontFamilySmall"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"fontFamilyMedium"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"fontFamilyLarge","type":"codeVoice"}]}]}],"type":"unorderedList"}]}]},{"level":2,"type":"heading","text":"Diagram: Runtime font resolution","anchor":"Diagram-Runtime-font-resolution"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"maps-font-runtime-flow.mermaid"}]},{"syntax":"mermaid","code":["%% file: maps-font-runtime-flow.codex.svg","%% title: Runtime font resolution flow","sequenceDiagram","  autonumber","  participant View as View or cell","  participant Token as TypographyToken","  participant Provider as FontProvider","  participant Scaler as DynamicTypeScaler","  participant Font as UIFont","","  View->>Token: request token titleMedium","  Token->>Provider: resolve token to descriptor","  Provider->>Scaler: apply content size category","  Scaler->>Font: return scaled font","  Font-->>View: set font"],"type":"codeListing"},{"text":"Diagram: Compat umbrella during transition","type":"heading","level":2,"anchor":"Diagram-Compat-umbrella-during-transition"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"maps-font-umbrella-after.mermaid"}]},{"code":["%% file: maps-font-umbrella-after.codex.svg","%% title: After - Canonical modules + compat facade","flowchart TB","  subgraph CANON[Canonical modules explicit layering]","    T[TypographyTokens + FontProvider]","    C[ColorTokens]","    I[IconCatalog]","    L[LayoutMetrics]","    A[Appearance\/Theming]","    X[Utilities]","  end","","  subgraph COMPAT[Compatibility facade temporary]","    U[DesignSystemCompat Umbrella]","  end","","  subgraph FEATURES[Features + components]","    F[Feature code]","    CMP[Reusable components]","  end","","  F -->|imports only what it uses| T","  F --> C","  F --> I","  CMP --> T","  CMP --> L","","  F -. legacy import .-> U","  CMP -. legacy import .-> U","","  U --> T","  U --> C","  U --> I","  U --> L","  U --> A","  U --> X","","  U --> R[Gradual elimination of transitive dependencies]"],"type":"codeListing","syntax":"mermaid"},{"level":2,"text":"Migration strategy","anchor":"Migration-strategy","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Freeze the typography spec and build a token map."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement a new font API and a compatibility layer for legacy calls."}]}]},{"content":[{"inlineContent":[{"text":"Scan the repo to inventory direct and indirect call sites.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Batch migrations by feature area to keep PRs reviewable."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Run targeted tests and snapshot updates per batch."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Roll out in canary stages with metrics gates."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Retire legacy APIs and enforce lint rules against old constructors."}]}]}],"type":"orderedList"},{"level":2,"text":"Batch prioritization recipe","anchor":"Batch-prioritization-recipe","type":"heading"},{"inlineContent":[{"type":"text","text":"Migrations were prioritized by repeatable automation recipes that the refactor"},{"text":" ","type":"text"},{"text":"tool could run end-to-end:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Find API call sites."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Replace imports."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace API usage with tokens."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Lint.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Build."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Test."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Update snapshots or baselines when expected."}]}]},{"content":[{"inlineContent":[{"text":"Send for review.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"text":"Example migration: Search Results row","anchor":"Example-migration-Search-Results-row","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Map title\/subtitle\/badge styles to tokens ("},{"type":"codeVoice","code":"titleMedium"},{"type":"text","text":", "},{"code":"bodySmall","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"caption"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Route legacy helper calls through shim D to the token registry."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Enable the new mapping behind a surface flag for Search Results."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Run max Dynamic Type snapshots and scroll perf benchmarks.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Promote after two green cohorts; keep rollback to legacy helpers.","type":"text"}]}]}],"type":"orderedList"},{"level":2,"text":"Diagram: Migration plan","anchor":"Diagram-Migration-plan","type":"heading"},{"inlineContent":[{"type":"image","identifier":"maps-font-migration-plan.mermaid"}],"type":"paragraph"},{"syntax":"mermaid","code":["%% file: maps-font-migration-plan.codex.svg","%% title: Migration plan - Staged rollout","flowchart TB","  S0[0. Spec freeze + token map] --> S1[1. Build new font API]","  S1 --> S2[2. Create compatibility shims]","  S2 --> S3[3. Repo scan + call-site inventory]","  S3 --> S4[4. Batch migrations by feature area]","  S4 --> S5[5. Targeted tests + snapshot updates]","  S5 --> S6[6. Canary rollout + metrics]","  S6 --> S7[7. Full rollout + cleanup old APIs]","  S7 --> S8[8. Enforce: lint forbidden constructors]","","  S2 -. rollback .-> R1[Rollback: feature flag \/ kill switch]","  S6 -. rollback .-> R1"],"type":"codeListing"},{"anchor":"Automation-pipeline","type":"heading","level":2,"text":"Automation pipeline"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Scan the codebase to locate font call sites."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Cluster results by module and owner."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Generate PR-sized batches and apply transformations.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Run targeted tests and snapshot suites.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Triage diffs, update baselines when expected, and track metrics.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Refactor-CLI-architecture","type":"heading","level":2,"text":"Refactor CLI architecture"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"refactor-cli"},{"type":"text","text":" tool runs on macOS or Linux cloud workers and executes a"},{"text":" ","type":"text"},{"text":"JSON array of steps (find, replace, add import, build, test, find screenshots,","type":"text"},{"text":" ","type":"text"},{"text":"send for review, set directory). It launches processes ad hoc and reports","type":"text"},{"text":" ","type":"text"},{"text":"failures directly from stdout\/stderr.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"maps-font-automation-cli-architecture.mermaid","type":"image"}],"type":"paragraph"},{"code":["%% file: maps-font-automation-cli-architecture.svg","%% title: Refactor CLI architecture","flowchart LR","  subgraph CLI[refactor-cli]","    S[JSON steps array]","    R[Step runner]","  end","","  subgraph RUNNER[Cloud worker]","    FS[Working directory]","    PROC[Ad hoc process launcher]","  end","","  subgraph TOOLS[Underlying tools]","    FIND[find]","    REPLACE[replace]","    IMPORT[add import]","    BUILD[build]","    TEST[test]","    SHOTS[find screenshots]","    REVIEW[send for review]","    SETDIR[set directory]","  end","","  S --> R --> PROC","  PROC --> TOOLS","  PROC --> OUT[stdout\/stderr]","  FS --> VC[Version control diffs]","  VC --> OUT"],"syntax":"mermaid","type":"codeListing"},{"anchor":"Before-to-after-API-sprawl-to-dependency-injection","type":"heading","level":2,"text":"Before to after: API sprawl to dependency injection"},{"inlineContent":[{"type":"image","identifier":"maps-font-before-after-di.mermaid"}],"type":"paragraph"},{"code":["%% file: maps-font-before-after-di.svg","%% title: Before to after - dependency injection + Dynamic Type path","flowchart LR","  subgraph BEFORE[Before: API sprawl]","    B1[UIFont fontWith]","    B2[AZFontWithStyle(enum1)]","    B3[MDCFont.font1]","    B4[MDC2Font.font4]","  end","","  subgraph AFTER[After: dependency injection]","    TOK[Typography tokens]","    DI[Injected FontProvider]","    DT[Dynamic Type scaler]","    OUT[UIFont \/ SwiftUI Font]","    TOK --> DI --> DT --> OUT","  end","","  subgraph REV[Reviewer actions]","    G[Linked guides]","    SH[Generated screenshots]","  end","","  BEFORE -->|shim + mapping| TOK","  OUT --> SH","  G --> SH"],"type":"codeListing","syntax":"mermaid"},{"anchor":"Contrast-color-upgrade","type":"heading","level":2,"text":"Contrast: color upgrade"},{"inlineContent":[{"text":"The earlier color upgrade had no design token usage. All changes were manual","type":"text"},{"type":"text","text":" "},{"text":"and applied directly by developers.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Snapshot triage loop","type":"heading","anchor":"Snapshot-triage-loop"},{"items":[{"content":[{"inlineContent":[{"text":"If a diff is expected, update baselines and record the reason.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If a diff is a regression, fix the mapping or layout constraint.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If a diff is noise, refine the test or filtering rule.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Rollout controls","type":"heading","anchor":"Rollout-controls"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature flags to enable quick rollback."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Canary cohorts by OS version and device class."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Monitoring for crash-free rate, layout regressions, and performance."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type 2 experimentation cohorts: 1, 5, 10, 50, 100."}]}]}],"type":"unorderedList"},{"text":"Testing And Validation","type":"heading","level":2,"anchor":"Testing-And-Validation"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Snapshot suites for key screens at multiple Dynamic Type sizes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Targeted UI tests for text-heavy flows and critical layouts."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Static analysis to block legacy API usage during the migration."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Runtime logging for fallback fonts and missing token mappings."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Snapshot baselines were generated in the cloud. We ran test targets, reviewed"},{"type":"text","text":" "},{"type":"text","text":"failures, then migrated old snapshot tests to the new baselines."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The automated snapshot tool failed on Linux when the command length exceeded"},{"type":"text","text":" "},{"type":"text","text":"the character limit, so batches were split to keep commands shorter."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Risks And Tradeoffs","type":"heading","level":2,"anchor":"Risks-And-Tradeoffs"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Tradeoff:"}],"type":"strong"},{"type":"text","text":" Temporary shim layer increases surface area."},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Benefit:"}],"type":"strong"},{"type":"text","text":" Safe migration without breaking call sites."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Tradeoff:"}],"type":"strong"},{"type":"text","text":" Duplicate APIs during transition."},{"type":"text","text":" "},{"inlineContent":[{"text":"Benefit:","type":"text"}],"type":"strong"},{"type":"text","text":" Teams can migrate on their own schedule."}]}]}],"type":"unorderedList"},{"type":"heading","text":"Decision rationale","level":2,"anchor":"Decision-rationale"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"A big-bang migration was rejected due to risk and review overhead."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An incremental shim-based approach limited blast radius and enabled"},{"type":"text","text":" "},{"type":"text","text":"multi-app adoption."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Shared components were migrated first to collapse indirect usage quickly."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/laussat-studio\/documentation\/laussat-studio","doc:\/\/laussat-studio\/documentation\/laussat-studio\/system-designs","doc:\/\/laussat-studio\/documentation\/laussat-studio\/google-maps-typography-design-overview"]]},"references":{"maps-font-runtime-flow.mermaid":{"va