{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"metadata":{"role":"article","images":[{"type":"icon","identifier":"system-designs-google-maps-font-system-deep-dive-expectations-icon.codex.svg"},{"type":"card","identifier":"system-designs-google-maps-font-system-deep-dive-expectations-card.codex.svg"}],"color":{"standardColorIdentifier":"gray"},"roleHeading":"Project Deep Dive Expectations","title":"Project Deep Dive Expectations"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"image","identifier":"doc-deep-dive-expectations-hero.codex"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"identifier":"system-designs-google-maps-font-system-deep-dive-expectations-hero.codex","type":"image"}]},{"text":"What they evaluate","anchor":"What-they-evaluate","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"They are evaluating senior impact: scope, ownership, complexity, execution,"},{"type":"text","text":" "},{"text":"collaboration, and measurable outcomes. You win by being concrete, quantified,","type":"text"},{"text":" ","type":"text"},{"text":"and decision-driven. This is not a code walkthrough.","type":"text"}]},{"text":"Ten-minute narrative template","anchor":"Ten-minute-narrative-template","type":"heading","level":2},{"text":"0:00 To 0:45 - Context and Why It Mattered","anchor":"000-To-045-Context-and-Why-It-Mattered","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Problem, user impact, business risk, scale."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Mention that the work is within the last year.","type":"text"}]}]}]},{"text":"0:45 To 1:45 - What You Were Solving For and Scope","anchor":"045-To-145-What-You-Were-Solving-For-and-Scope","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Success definition and constraints."}]}]},{"content":[{"inlineContent":[{"text":"Explicit non-goals and why they were excluded.","type":"text"}],"type":"paragraph"}]}]},{"text":"1:45 To 3:00 - Ownership Boundaries","anchor":"145-To-300-Ownership-Boundaries","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"“I owned X end to end” from design to rollout and metrics.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"“I did not own Y, but I influenced it by Z.”","type":"text"}],"type":"paragraph"}]}]},{"text":"3:00 To 4:30 - One Visual","anchor":"300-To-430-One-Visual","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"One system diagram: client to services to storage and cache to observability.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Point out where the hard part lives and where failures are handled."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Use Search Results as the concrete example for the data flow and layout risks."}],"type":"paragraph"}]}]},{"text":"4:30 To 6:30 - Technical Depth","anchor":"430-To-630-Technical-Depth","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Two to three decisions only.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"For each: decision, alternatives, tradeoff, why correct for constraints."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Include the font caching policy and the surface-level flag strategy."}]}]}]},{"text":"6:30 To 7:30 - Execution and Rollout","anchor":"630-To-730-Execution-and-Rollout","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Milestones, feature flags, staged rollout, canary, regression handling."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Oncall follow-through."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Mention max Dynamic Type snapshots for Search Results and scroll perf gates."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"7:30 To 8:30 - Outcomes","anchor":"730-To-830-Outcomes","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Quantified before and after deltas."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Tie directly back to the original goal."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Call out the Search Results deltas (truncation fixes, diff count, perf)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"8:30 To 9:30 - Collaboration and Mentoring","anchor":"830-To-930-Collaboration-and-Mentoring","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Partner teams, QA strategy, coordination mechanisms."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Mentoring and the resulting leverage."}],"type":"paragraph"}]}]},{"text":"9:30 To 10:00 - Learnings and Next Step","anchor":"930-To-1000-Learnings-and-Next-Step","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"One technical learning, one process learning.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A credible next step."}]}]}]},{"text":"Common ways candidates lose","anchor":"Common-ways-candidates-lose","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Too much background and not enough “I did X; result was Y.”"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Listing technologies without explaining the choices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No rollout or validation story."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No metrics or only vague metrics.","type":"text"}]}]}]},{"level":2,"anchor":"Transition-mindset","type":"heading","text":"Transition mindset"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Coding exercise mindset: ship correctness fast, prove with state and tests,"},{"text":" ","type":"text"},{"text":"polish last.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep dive mindset: tell a decision-and-results story, show ownership and"},{"type":"text","text":" "},{"type":"text","text":"impact with numbers."}]}]}]},{"text":"Offer to draft the script","anchor":"Offer-to-draft-the-script","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"If you provide a one-paragraph description of your deep dive project"},{"type":"text","text":" "},{"type":"text","text":"(problem, role, and one outcome metric), we will produce a tight 10-minute"},{"type":"text","text":" "},{"text":"script plus the diagram content you should draw from memory.","type":"text"}],"type":"paragraph"},{"anchor":"Diagram-Context-snapshot","type":"heading","level":2,"text":"Diagram: Context snapshot"},{"type":"paragraph","inlineContent":[{"identifier":"system-designs-google-maps-font-system-deep-dive-expectations-context.mermaid","type":"image"}]},{"type":"codeListing","code":["%% file: system-designs-google-maps-font-system-deep-dive-expectations-context.svg","%% title: Project Deep Dive Expectations - Context snapshot","flowchart LR","  A[\"Project Deep Dive Expectations\"] --> B[\"Constraints and scope\"]","  B --> C[\"Complexity drivers\"]","  C --> D[\"Design tradeoffs\"]","  D --> E[\"Risk: regressions and drift\"]","  D --> F[\"Risk: migration cost\"]","  D --> G[