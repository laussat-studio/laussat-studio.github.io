{"hierarchy":{"paths":[["doc:\/\/laussat-studio\/documentation\/laussat-studio"]]},"metadata":{"title":"Automated testing","images":[{"type":"icon","identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.automated-testing-icon.codex.svg"},{"type":"card","identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.automated-testing-card.codex.svg"}],"roleHeading":"Article","color":{"standardColorIdentifier":"gray"},"role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/laussat-studio\/documentation\/laussat-studio\/challenge.app-complexity.automated-testing"},"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.automated-testing-hero.codex","type":"image"}]},{"type":"paragraph","inlineContent":[{"text":"This page records how the Google Maps typography system addressed “Automated testing”.","type":"text"}]},{"level":2,"text":"Challenge","anchor":"Challenge","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Automated screenshot tooling could not keep up with the scope of typography"},{"type":"text","text":" "},{"type":"text","text":"changes. The auto-upgrade pipeline broke because screenshots could only be"},{"type":"text","text":" "},{"type":"text","text":"generated on Linux, and the existing split\/automation tools assumed changes"},{"text":" ","type":"text"},{"text":"stayed within known logical boundaries (for example, a single library). A","type":"text"},{"text":" ","type":"text"},{"text":"fundamental design primitive touched everything, so that assumption failed.","type":"text"}]},{"type":"heading","level":2,"anchor":"System-design-response","text":"System design response"},{"type":"paragraph","inlineContent":[{"type":"text","text":"We hand-processed JSONL bundles that carried the dynamic locations of"},{"text":" ","type":"text"},{"text":"screenshots to migrate. A custom workflow would:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"find the test output on the build server,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"decode the JSONL bundle,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"copy the screenshots into the correct cloud version-control environment."}]}]}]},{"type":"heading","level":2,"anchor":"Evidence-and-remaining-risk","text":"Evidence and remaining risk"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Remaining risk: long-running test runners remained a bottleneck even after the"},{"type":"text","text":" "},{"type":"text","text":"manual migration workflow."}]},{"anchor":"Diagram-Context-snapshot","type":"heading","level":2,"text":"Diagram: Context snapshot"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.automated-testing-context.mermaid"}]},{"code":["%% file: system-designs-google-maps-font-system-scaling-challenges-challenge.app-complexity.automated-testing-context.svg","%% title: Automated testing - Context snapshot","flowchart LR","  A[\"Challenge: Automated testing\"] --> B[\"Constraint or pressure\"]","  B --> C[\"System design response\"]","  C --> D[\"Evidence and remaining risk\"]"],"type":"codeListing","syntax":"mermaid"}],"kind":"content"}],"kind":"article","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"laussat-studio-icon.codex.svg":{"variants":[{"svgID":"title","traits":["1x","light"],"url":"\/images\/laussat-studio\/laussat-studio-icon.codex.svg"}],"alt":"Studio Laussat Icon","type":"image","identifier":"laussat-studio-icon.codex.svg"},"doc://laussat-studio/documentation/laussat-studio":{"kind":"article","typ